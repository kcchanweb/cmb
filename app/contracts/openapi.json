{
  "openapi": "3.1.0",
  "info": {
    "title": "POC Event Relay API",
    "version": "0.2.0",
    "description": "Local Express API with direct vendor delivery and PostgreSQL-backed deduplication. One event, JSON max64KiB/depth20; valid Unicode, finite numbers. No public-deployment authentication is configured."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3000"
    }
  ],
  "paths": {
    "/events": {
      "post": {
        "operationId": "submitEvent",
        "summary": "Persist a source event once and directly deliver eligible events",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SourceEvent"
              },
              "example": {
                "type": "track",
                "event": "purchase",
                "messageId": "demo-purchase-001",
                "timestamp": "2026-09-01T11:49:25Z",
                "receivedAt": "2026-09-01T12:00:00Z",
                "userId": "987654",
                "deviceId": "demo-device-001",
                "properties": {
                  "revenue": 49.99,
                  "currency": "CAD",
                  "sku": "demo-product"
                },
                "context": {
                  "app": {
                    "version": "2.4.1"
                  },
                  "device": {
                    "type": "ios"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "400": {
            "description": "Malformed JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds64KiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported content type/encoding",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Identity conflict or delivery ownership changed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected safe failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "201": {
            "description": "New event delivered or retained as skipped",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventResult"
                }
              }
            }
          },
          "200": {
            "description": "Existing identical event; no new send",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventResult"
                }
              }
            }
          },
          "202": {
            "description": "Retained pending or active delivery; no automatic background processing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventResult"
                }
              }
            }
          },
          "502": {
            "description": "Stored permanent vendor failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventResult"
                }
              }
            }
          },
          "503": {
            "description": "Stored transient vendor failure (EventResult), or admission/persistence failure (ErrorResponse)",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/EventResult"
                    },
                    {
                      "$ref": "#/components/schemas/ErrorResponse"
                    }
                  ]
                }
              }
            }
          },
          "504": {
            "description": "Stored uncertain vendor outcome",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventResult"
                }
              }
            }
          }
        }
      }
    },
    "/events/{id}": {
      "get": {
        "operationId": "eventStatus",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Internal generated UUID returned as eventId."
          }
        ],
        "responses": {
          "200": {
            "description": "Saved delivery status without source data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventResult"
                }
              }
            }
          },
          "404": {
            "description": "No tracked event",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid UUID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable or admission limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/events/{id}/retry": {
      "post": {
        "operationId": "retryEvent",
        "summary": "Explicit retry using the frozen saved vendor payload",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Internal generated UUID returned as eventId."
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "maxProperties": 0,
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "400": {
            "description": "Malformed JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds64KiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported content type/encoding",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Identity conflict or delivery ownership changed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected safe failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "200": {
            "description": "Existing identical event; no new send",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventResult"
                }
              }
            }
          },
          "202": {
            "description": "Retained pending or active delivery; no automatic background processing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventResult"
                }
              }
            }
          },
          "502": {
            "description": "Stored permanent vendor failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventResult"
                }
              }
            }
          },
          "503": {
            "description": "Stored transient vendor failure (EventResult), or admission/persistence failure (ErrorResponse)",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/EventResult"
                    },
                    {
                      "$ref": "#/components/schemas/ErrorResponse"
                    }
                  ]
                }
              }
            }
          },
          "504": {
            "description": "Stored uncertain vendor outcome",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventResult"
                }
              }
            }
          },
          "404": {
            "description": "No tracked event",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SourceEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "event",
          "messageId",
          "deviceId",
          "timestamp"
        ],
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S"
          },
          "event": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S",
            "description": "Original source name; names outside the vendor allowlist are retained as skipped."
          },
          "messageId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S",
            "description": "Stable external deduplication identity, not the generated table UUID."
          },
          "deviceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Real timezone-qualified instant, 1\u20136 fractional digits; runtime validates calendar and supported bounds. Epoch milliseconds must be strictly between 1e12 and 1e13."
          },
          "receivedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Real timezone-qualified instant, 1\u20136 fractional digits; runtime validates calendar and supported bounds."
          },
          "userId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S",
            "anyOf": [
              {
                "pattern": "^\\d+$"
              },
              {
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              }
            ]
          },
          "properties": {
            "type": "object",
            "additionalProperties": true
          },
          "context": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "app": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "\\S"
                  }
                }
              },
              "device": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "type": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "\\S"
                  },
                  "advertisingId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "\\S"
                  }
                }
              },
              "os": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "\\S"
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "\\S"
                  }
                }
              },
              "locale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "\\S"
              }
            }
          },
          "traits": {
            "type": "object",
            "additionalProperties": true,
            "writeOnly": true,
            "description": "Validated JSON then discarded: not persisted, fingerprinted, or forwarded."
          }
        }
      },
      "EventResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "eventId",
          "messageId",
          "status",
          "duplicate",
          "attempts",
          "vendorStatus",
          "errorCode"
        ],
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "messageId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "sending",
              "delivered",
              "skipped",
              "retryable_failed",
              "permanent_failed",
              "uncertain"
            ]
          },
          "duplicate": {
            "type": "boolean"
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "vendorStatus": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 100,
            "maximum": 599
          },
          "errorCode": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message",
              "requestId"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      }
    }
  }
}
